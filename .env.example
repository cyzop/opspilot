OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional reserve model (same provider and key). Blank or equal to OPENROUTER_MODEL = no reserve.
OPENROUTER_MODEL_FALLBACK=

# GET /stats: USD por 1M de tokens de prompt (modelos :free custam 0)
OPSPILOT_MODEL_PRICES=

# CORS: origens que podem chamar a API pelo navegador (separadas por vírgula; nunca *)
OPSPILOT_CORS_ORIGINS=http://localhost:5173
# Com a War Room publicada no GitHub Pages:
# OPSPILOT_CORS_ORIGINS=http://localhost:5173,https://cyzop.github.io
